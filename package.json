{
  "name": "cotimporta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:load-official": "node --env-file-if-exists=.env src/db/load-official.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@google/genai": "3.3.0",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.22",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pdfjs-dist": "6.5.438",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
